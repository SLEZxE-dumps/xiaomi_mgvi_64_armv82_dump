	};

	fragment@18 {
		target = <0xffffffff>;

		__overlay__ {

			awinic_reset_low {
				phandle = <0x15>;

				pins_cmd_dat {
					pinmux = <0x8300>;
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
				};
			};

			awinic_reset_high {
				phandle = <0x16>;

				pins_cmd_dat {
					pinmux = <0x8300>;
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
					output-high;
				};
			};

			awinic_interrupt_high {
				phandle = <0x17>;

				pins_cmd_dat {
					pinmux = <0xe00>;
					drive-strength = <0x02>;
					slew-rate = <0x00>;
					bias-pull-up;
					input-enable;
				};
			};
		};
	};

	fragment@19 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "mediatek,disp-leds";

			backlight {
				label = "lcd-backlight";
				max-brightness = <0x3fff>;
				min-brightness = <0x01>;
				max-hw-brightness = <0xfff>;
				pq-max-51backlight-threshold = <0x60>;
				led_mode = <0x04>;
				default-state = "FifteenPercent";
			};
		};
	};

	fragment@20 {
		target = <0xffffffff>;

		__overlay__ {

			lcm_dvdd_enp1_gpio {
				phandle = <0x18>;

				pins_cmd_dat {
					pinmux = <0x5b00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm_dvdd_enp0_gpio {
				phandle = <0x19>;

				pins_cmd_dat {
					pinmux = <0x5b00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm_vddio_enn1_gpio {
				phandle = <0x1a>;

				pins_cmd_dat {
					pinmux = <0x5f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm_vddio_enn0_gpio {
				phandle = <0x1b>;

				pins_cmd_dat {
					pinmux = <0x5f00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm_rst_out1_gpio {
				phandle = <0x1c>;

				pins_cmd_dat {
					pinmux = <0x3000>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm_rst_out0_gpio {
				phandle = <0x1d>;

				pins_cmd_dat {
					pinmux = <0x3000>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm_dsi_te {
				phandle = <0x1e>;

				pins_cmd_dat {
					pinmux = <0x2f01>;
				};
			};

			lcm_err_flag {
				phandle = <0x1f>;

				pins_cmd_dat {
					pinmux = <0x300>;
					slew-rate = <0x00>;
					bias-pull-up = <0x0b>;
					input-enable;
				};
			};
		};
	};

	fragment@21 {
