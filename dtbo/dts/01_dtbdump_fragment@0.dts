/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			bootargs_ext = "console=tty0 root=/dev/ram vmalloc=400M 8250.nr_uarts=4 loglevel=8 \n\n\n\ninitcall_debug=1";
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			thermal-message {
				board-sensor = "VIRTUAL-SENSOR";
				phandle = <0x7a>;
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			gps_default {
				phandle = <0x01>;
			};

			gps-l1-lna0 {
				phandle = <0x02>;

				pins-cmd-dat {
					pinmux = <0x1000>;
					output-low;
				};
			};

			gps-l1-lna1 {
				phandle = <0x03>;

				pins-cmd-dat {
					pinmux = <0x1001>;
				};
			};

			gps-l1-lna2 {
				phandle = <0x04>;

				pins-cmd-dat {
					pinmux = <0x1000>;
					output-high;
				};
			};

			gps-l5-lna0 {
				phandle = <0x05>;

				pins-cmd-dat {
					pinmux = <0x1100>;
					output-low;
				};
			};

			gps-l5-lna1 {
				phandle = <0x06>;

				pins-cmd-dat {
					pinmux = <0x1101>;
				};
			};

			gps-l5-lna2 {
				phandle = <0x07>;

				pins-cmd-dat {
					pinmux = <0x1100>;
					output-high;
				};
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "default\0gps_l1_lna_disable\0gps_l1_lna_dsp_ctrl\0gps_l1_lna_enable\0gps_l5_lna_disable\0gps_l5_lna_dsp_ctrl\0gps_l5_lna_enable";
			pinctrl-0 = <0x01>;
			pinctrl-1 = <0x02>;
			pinctrl-2 = <0x03>;
			pinctrl-3 = <0x04>;
			pinctrl-4 = <0x05>;
			pinctrl-5 = <0x06>;
			pinctrl-6 = <0x07>;
			status = "okay";
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			sel_high {
				phandle = <0x0a>;

				pins_cmd_dat {
					pinmux = <0x5c00>;
					output-high;
				};
			};

			sel_low {
				phandle = <0x0b>;

				pins_cmd_dat {
					pinmux = <0x5c00>;
					output-low;
				};
			};

			sw_enable {
				phandle = <0x0c>;

				pins_cmd_dat {
					pinmux = <0x5000>;
					output-low;
				};
			};

			sw_disable {
				phandle = <0x0d>;

				pins_cmd_dat {
					pinmux = <0x5000>;
					output-low;
				};
			};

			ps_enable {
				phandle = <0x08>;

				pins_cmd_dat {
					pinmux = <0x5f00>;
					output-high;
				};
			};

			ps_disable {
				phandle = <0x09>;

				pins_cmd_dat {
					pinmux = <0x5f00>;
					output-low;
				};
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "enable\0disable";
			pinctrl-0 = <0x08>;
			pinctrl-1 = <0x09>;
			status = "disabled";
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "sel_up\0sel_down\0enable\0disable";
			pinctrl-0 = <0x0a>;
			pinctrl-1 = <0x0b>;
			pinctrl-2 = <0x0c>;
			pinctrl-3 = <0x0d>;
			status = "okay";
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {

			port {

				endpoint@0 {
					remote-endpoint = <0x0e>;
					phandle = <0x0f>;
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
			orientation-switch;
			mode-switch;
			accessory;

			port {

				endpoint@0 {
					remote-endpoint = <0x0f>;
					phandle = <0x0e>;
				};
			};
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {
			pd_vbus_upper_bound = <0xb71b00>;
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {

			epa_elna_mtk {
				parts = <0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff>;

				wifi {

					flags-1 {
					};

					flags-2 {
					};

					flags-3 {
					};

					flags-4 {
					};
				};

				bt {

					flags-1 {
						epa_elna;
					};

					flags-2 {
						bypass;
					};

					flags-3 {
						epa_elna;
					};

					flags-4 {
						bypass;
					};
				};
			};
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "mediatek,mt6886-mt6368-sound";
			mediatek,platform = <0xffffffff>;
			mediatek,snd_audio_dsp = <0xffffffff>;
			mediatek,spk-i2s = <0x03 0x09>;

			mediatek,speaker-codec {
				sound-dai = <0x10 0x11>;
			};
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;
			status = "okay";

			aw882xx_smartpa@34 {
				compatible = "awinic,aw882xx_smartpa";
				#sound-dai-cells = <0x00>;
				reg = <0x34>;
				reset-gpio = <0xffffffff 0xbd 0x00>;
				irq-gpio = <0xffffffff 0x5c 0x00>;
				spk-sw-gpio = <0xffffffff 0x5d 0x00>;
				sound-channel = <0x00>;
				aw-re-min = <0xfa0>;
				aw-re-max = <0x7530>;
				status = "okay";
				phandle = <0x10>;
			};

			aw882xx_smartpa@35 {
				compatible = "awinic,aw882xx_smartpa";
				#sound-dai-cells = <0x00>;
				reg = <0x35>;
				reset-gpio = <0xffffffff 0xbc 0x00>;
				irq-gpio = <0xffffffff 0x65 0x00>;
				sound-channel = <0x01>;
				aw-re-min = <0xfa0>;
				aw-re-max = <0x7530>;
				status = "okay";
				phandle = <0x11>;
			};
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {

			uart_gpio_enable@gpio0 {
				phandle = <0x12>;

				pins_cmd_dat {
					pinmux = <0x00>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
				};
			};

			uart_gpio_disable@gpio0 {
				phandle = <0x13>;

				pins_cmd_dat {
					pinmux = <0x00>;
					slew-rate = <0x01>;
					bias-disable;
					output-high;
				};
			};
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {

			et7480@42 {
				status = "ok";
				compatible = "mediatek,et7480-audioswitch";
				reg = <0x42>;
				pinctrl-names = "uart_enable\0uart_disable";
				pinctrl-0 = <0x12>;
				pinctrl-1 = <0x13>;
				phandle = <0x14>;
			};
		};
	};

	fragment@16 {
		target = <0xffffffff>;

		__overlay__ {
			et7480-i2c-handle = <0x14>;
		};
	};

	fragment@17 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;
			status = "ok";

			aw869x_haptic@5a {
				compatible = "awinic,awinic_haptic";
				reg = <0x5a>;
				reset-gpio = <0xffffffff 0x83 0x00>;
				irq-gpio = <0xffffffff 0x0e 0x00>;
				pinctrl-names = "awinic_reset_low\0awinic_reset_high\0awinic_interrupt_high";
				pinctrl-0 = <0x15>;
				pinctrl-1 = <0x16>;
				pinctrl-2 = <0x17>;
				aw869x_vib_mode = <0x00>;
				aw869x_vib_f0_pre = <0x6a4>;
				aw869x_vib_f0_cali_percen = <0x07>;
				aw869x_vib_cont_drv_lev = <0x69>;
				aw869x_vib_cont_drv_lvl_ov = <0x7d>;
				aw869x_vib_cont_td = <0x9a>;
				aw869x_vib_cont_zc_thr = <0xff1>;
				aw869x_vib_cont_num_brk = <0x03>;
				aw869x_vib_f0_coeff = <0x104>;
				aw869x_vib_f0_trace_parameter = <0x05 0x03 0x02 0x0f>;
				aw869x_vib_bemf_config = <0x10 0x08 0x03 0xf8>;
				aw869x_vib_sw_brake = <0x2c>;
				aw869x_vib_tset = <0x12>;
				aw869x_vib_r_spare = <0x68>;
				aw869x_vib_bstdbg = <0x30 0xeb 0xd4 0x00 0x00 0x00>;
				aw869x_vib_trig_config = <0x00 0x01 0x00 0x01 0x02 0x00 0x01 0x00 0x01 0x02 0x00 0x01 0x00 0x01 0x02>;
				aw869x_vib_bst_vol_default = <0x21>;
				aw869x_vib_bst_vol_ram = <0x21>;
				aw869x_vib_bst_vol_rtp = <0x21>;
				aw86927_vib_mode = <0x00>;
				aw86927_vib_f0_pre = <0x6a4>;
				aw86927_vib_f0_cali_percen = <0x08>;
				aw86927_vib_cont_drv1_lvl = <0x7f>;
				aw86927_vib_cont_drv2_lvl = <0x34>;
				aw86927_vib_cont_lra_vrms = <0x4b0>;
				aw86927_vib_cont_drv1_time = <0x04>;
				aw86927_vib_cont_drv2_time = <0x06>;
				aw86927_vib_cont_drv_width = <0x6a>;
				aw86927_vib_cont_wait_num = <0x06>;
